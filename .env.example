# MYWARD Environment Variables
# Copy this file to `.env` (local development) or add these in
# Vercel → Project Settings → Environment Variables (production).

# ─────────────────────────────
# Database (for Phase 2 backend)
# ─────────────────────────────
# SQLite for development, Postgres for production
# DATABASE_URL="file:./db/myward.db"
# DATABASE_URL="postgresql://user:password@host:5432/myward?schema=public"

# ─────────────────────────────
# Authentication (NextAuth.js)
# ─────────────────────────────
# NEXTAUTH_URL="https://your-domain.vercel.app"
# NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ─────────────────────────────
# OTP / SMS service (for phone login)
# ─────────────────────────────
# MSG91_AUTH_KEY="your-msg91-key"
# MSG92_SENDER_ID="MYWARD"

# ─────────────────────────────
# File storage (for issue photos)
# ─────────────────────────────
# AWS_S3_BUCKET="myward-photos"
# AWS_S3_REGION="ap-south-1"
# AWS_S3_ACCESS_KEY_ID="your-key"
# AWS_S3_SECRET_ACCESS_KEY="your-secret"

# ─────────────────────────────
# Push notifications (for emergency alerts)
# ─────────────────────────────
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public"
# VAPID_PRIVATE_KEY="your-vapid-private"
